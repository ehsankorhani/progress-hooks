---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Stellar Facts">
  <section class="center" style="padding-block: 4rem;">
    <p style="font-size: 4rem; margin: 0;">🛰️</p>
    <h1 style="font-size: 2.2rem;">Lost in space</h1>
    <p class="muted">The page you're looking for drifted out of orbit.</p>
    <p>
      <a href="/" style="color: #1a1300; background: var(--accent); padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700;">
        Back to Earth
      </a>
    </p>
  </section>
</BaseLayout>
