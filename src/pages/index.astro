---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FactCard from '../components/FactCard.astro';

const facts = (await getCollection('facts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Stellar Facts — bite-sized facts about space">
  <section class="center">
    <p class="muted" style="font-size: 0.9rem; letter-spacing: 0.2em; text-transform: uppercase;">A tiny Astro 7 sample site</p>
    <h1 style="font-size: clamp(2.2rem, 6vw, 3.5rem); margin-bottom: 0.5rem;">
      Bite-sized facts about <span style="color: var(--accent)">space</span>
    </h1>
    <p style="max-width: 38rem; margin-inline: auto; font-size: 1.1rem;" class="muted">
      Real astronomy, lightly simplified. One wow-fact at a time, rendered to static HTML
      by Astro {Astro.generator.replace('Astro v', '')}.
    </p>
    <p style="margin-top: 1.5rem;">
      <a href="/facts/" style="color: #1a1300; background: var(--accent); padding: 0.7rem 1.4rem; border-radius: 999px; text-decoration: none; font-weight: 700;">
        Browse all {facts.length} facts →
      </a>
    </p>
  </section>

  <section style="margin-top: 4rem;">
    <h2 style="font-size: 1.3rem;">Latest facts</h2>
    <ul class="card-grid" style="margin-top: 1.25rem;">
      {facts.slice(0, 6).map((fact) => <FactCard fact={fact} />)}
    </ul>
  </section>
</BaseLayout>
