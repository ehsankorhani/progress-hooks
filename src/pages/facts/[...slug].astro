---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const facts = await getCollection('facts');
  return facts.map((fact) => ({
    params: { slug: fact.id },
    props: { fact },
  }));
}

const { fact } = Astro.props;
const { Content } = await render(fact);
const { title, tagline, date, wow, tags } = fact.data;
---

<BaseLayout title={`${title} — Stellar Facts`} description={tagline}>
  <article style="max-width: 44rem; margin-inline: auto;">
    <p class="muted" style="font-size: 0.9rem;">
      <a href="/facts/">← All facts</a>
    </p>

    <h1 style="font-size: clamp(1.8rem, 5vw, 2.6rem);">{title}</h1>
    <p style="font-size: 1.15rem; color: var(--accent); margin-top: -0.5rem;">{tagline}</p>

    <p class="muted" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
      <span>🔥 {wow}/100</span>
      <span>·</span>
      <span>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
    </p>

    <div>
      {tags.map((tag) => <span class="tag">#{tag}</span>)}
    </div>

    <hr style="border: none; border-top: 1px solid var(--border); margin: 2rem 0;" />

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
